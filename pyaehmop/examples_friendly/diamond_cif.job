cif
diamond_primitive.cif

# Bands, DOS and charges at explicitly specified k points.
calculations = energy, bands, dos, charges
band_path = L:0.5,0.5,0.5; G:0,0,0; X:0.5,0,0.5
divisions = 40
kpoints = 0,0,0; 0.5,0,0.5; 0.5,0.5,0.5
images = 5 5 5
# Same custom EHT parameters as the original YAeHMOP diamond example.
parameters = C 6 4 2 1.71 -21.4 2 1.625 -11.4
cutoff = 11
dos_sigma = 0.15
workers = 2
plots = yes
outputs = json, csv
output = ../results/friendly_diamond_cif
