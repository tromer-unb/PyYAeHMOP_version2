#!/bin/bash
#PBS -N graphene_EHT
#PBS -q workq
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=16:mem=8gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1
# Submit from repository root with qsub examples/transport/run.pbs
. .venv/bin/activate
python -m pyaehmop examples/transport/graphene.transport.job --workers 16
