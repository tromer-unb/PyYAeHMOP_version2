#!/bin/bash
#PBS -N EHT_direct_cif
#PBS -l select=1:ncpus=16:mpiprocs=1:ompthreads=16:mem=12gb
#PBS -l walltime=02:00:00
#PBS -j oe
set -euo pipefail
cd "$PBS_O_WORKDIR"
export OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 MPLBACKEND=Agg
ulimit -c 0
"${PYTHON:-python}" -m examples.transport.validate_direct_cif
