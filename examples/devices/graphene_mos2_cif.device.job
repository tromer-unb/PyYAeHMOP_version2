# Direct CIF input: common P1 coordinate box, physical repeats specified below.
structure_format = cif
cif_origin = cif_sources/graphene_mos2/origin.json
electrode_left = cif_sources/graphene_mos2/left.cif
scattering_region = cif_sources/graphene_mos2/device.cif
electrode_right = cif_sources/graphene_mos2/right.cif
transverse_vectors = 9.838048 0 0
left_repeat = 0 0 8.52
right_repeat = 0 0 5.679999661100459
parameters = ../transport/carbon_pdz7_4B.dat
K = 2.0068527138311567
cutoff = 3.5
quadrature = 16 12 8
energy_reference_eV = -18.800896640571224
energy_min = -2
energy_max = 2
energy_points = 21
transverse_kpoints = 3
workers = 8
calculations = transmission, conductance, iv
output = results/cif_direct/graphene_mos2
plots = true
